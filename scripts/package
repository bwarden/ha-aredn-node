#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

VERSION="${1:-$(python3 -c "import json; print(json.load(open('custom_components/aredn_node/manifest.json'))['version'])")}"
OUT="aredn_node-${VERSION}.zip"

cd custom_components
zip -r "../${OUT}" aredn_node -x '*/__pycache__/*' '*/__pycache__'
cd ..

echo "Created ${OUT}"